:CompositeOrder rdf:type owl:NamedIndividual ,
                         :ClassicalOrder ;
                rdfs:label "Composite order"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "A classical-order concept used to classify elements whose capitals combine Corinthian foliage with Ionic volutes."@en ;
                :hasAATReference <http://vocab.getty.edu/aat/300067415> .


###  https://wanqin-liu.github.io/ahkto/CorinthianOrder
:CorinthianOrder rdf:type owl:NamedIndividual ,
                          :ClassicalOrder ;
                 rdfs:label "Corinthian order"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A classical-order concept used to classify elements with bell-shaped capitals ornamented with foliage, commonly acanthus, and spiral forms."@en ;
                 :hasAATReference <http://vocab.getty.edu/aat/300067417> .


###  https://wanqin-liu.github.io/ahkto/DoricOrder
:DoricOrder rdf:type owl:NamedIndividual ,
                     :ClassicalOrder ;
            rdfs:label "Doric order"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "A classical-order concept used to classify elements with simple capitals and a triglyph-and-metope frieze; Greek Doric columns generally lack bases."@en ;
            :hasAATReference <http://vocab.getty.edu/aat/300067406> .


###  https://wanqin-liu.github.io/ahkto/IonicOrder
:IonicOrder rdf:type owl:NamedIndividual ,
                     :ClassicalOrder ;
            rdfs:label "Ionic order"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "A classical-order concept used to classify elements with volute capitals, moulded decoration and columns supported on bases."@en ;
            :hasAATReference <http://vocab.getty.edu/aat/300067423> .


###  https://wanqin-liu.github.io/ahkto/TuscanOrder
:TuscanOrder rdf:type owl:NamedIndividual ,
                      :ClassicalOrder ;
             rdfs:label "Tuscan order"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "A classical-order concept used to classify elements with smooth columns, torus bases, simple cushion capitals and undecorated friezes."@en ;
             :hasAATReference <http://vocab.getty.edu/aat/300067420> .


