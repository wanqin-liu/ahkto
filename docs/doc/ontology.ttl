@prefix : <https://wanqin-liu.github.io/ahkto/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://wanqin-liu.github.io/ahkto/> .

<https://wanqin-liu.github.io/ahkto/> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://wanqin-liu.github.io/ahkto/0.1.0> ;
                                       owl:imports <http://www.cidoc-crm.org/cidoc-crm/owl/7.1.3/> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty .


###  https://wanqin-liu.github.io/ahkto/hasAATReference
:hasAATReference rdf:type owl:AnnotationProperty ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Associates an ontology class with a corresponding concept in the Getty Art & Architecture Thesaurus (AAT) as a terminological reference. This annotation supports terminology reuse and traceability without asserting semantic equivalence or a formal class-level mapping."@en .


#################################################################
#    Object Properties
#################################################################

###  https://wanqin-liu.github.io/ahkto/adjacentTo
:adjacentTo rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P122_borders_with> ;
            rdf:type owl:SymmetricProperty ;
            rdfs:domain :ArchitecturalSpace ;
            rdfs:range :ArchitecturalSpace ;
            rdfs:label "is adjacent to"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates two distinct spaces that meet at a common boundary. The relation reads in either direction and does not require a doorway between the spaces."@en .


###  https://wanqin-liu.github.io/ahkto/bounds
:bounds rdf:type owl:ObjectProperty ;
        rdfs:domain :ArchitecturalElement ;
        rdfs:range :ArchitecturalSpace ;
        rdfs:label "bounds"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates an architectural element to a space whose boundary it defines in whole or in part."@en .


###  https://wanqin-liu.github.io/ahkto/containsArchitecturalSpace
:containsArchitecturalSpace rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P89i_contains> ;
                            owl:inverseOf :isContainedAsAnArchitecturalSpaceIn ;
                            rdfs:domain :Storey ;
                            rdfs:range :ArchitecturalSpace ;
                            rdfs:label "contains architectural space"@en ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates a storey to an architectural space lying within its spatial extent."@en .


###  https://wanqin-liu.github.io/ahkto/containsElement
:containsElement rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53i_is_former_or_current_location_of> ;
                 owl:inverseOf :isContainedAsAnElementIn ;
                 rdfs:domain :ArchitecturalSpace ;
                 rdfs:range :ArchitecturalElement ;
                 rdfs:label "contains element"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Records an architectural element located within the space. Boundary elements are documented with is bounded by when that is the observed relationship."@en .


###  https://wanqin-liu.github.io/ahkto/containsSculpture
:containsSculpture rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53i_is_former_or_current_location_of> ;
                   owl:inverseOf :isContainedAsASculptureIn ;
                   rdfs:domain :ArchitecturalSpace ;
                   rdfs:range :SculptureObject ;
                   rdfs:label "contains sculpture"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Records the location of a sculptural object in a space. It applies to both freestanding and installed objects."@en .


###  https://wanqin-liu.github.io/ahkto/hasArchType
:hasArchType rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
             owl:inverseOf :isArchTypeOf ;
             rdfs:domain :Arch ;
             rdfs:range :ArchType ;
             rdfs:label "has arch type"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Assigns a form or construction category to an individual arch."@en .


###  https://wanqin-liu.github.io/ahkto/hasArchitecturalDecorationType
:hasArchitecturalDecorationType rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                                owl:inverseOf :isArchitecturalDecorationTypeOf ;
                                rdfs:domain :ArchitecturalDecorativeFeature ;
                                rdfs:range :ArchitecturalDecorationType ;
                                rdfs:label "has architectural decoration type"@en ;
                                <http://www.w3.org/2004/02/skos/core#scopeNote> "Classifies a decorative feature by a recorded aspect of its medium, form or motif."@en .


###  https://wanqin-liu.github.io/ahkto/hasArchitecturalSpace
:hasArchitecturalSpace rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P59_has_section> ;
                       owl:inverseOf :isArchitecturalSpaceOf ;
                       rdfs:domain :Building ;
                       rdfs:range :ArchitecturalSpace ;
                       rdfs:label "has architectural space"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates a building to an identifiable architectural space belonging to it. This relation can describe a space extending across several storeys."@en .


###  https://wanqin-liu.github.io/ahkto/hasArchitecturalStratigraphicUnit
:hasArchitecturalStratigraphicUnit rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
                                   owl:inverseOf :isArchitecturalStratigraphicUnitOf ;
                                   rdfs:domain :ArchitecturalElement ;
                                   rdfs:range :ArchitecturalStratigraphicUnit ;
                                   rdfs:label "has architectural stratigraphic unit"@en ;
                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates an element to a recognisable portion of its fabric interpreted as evidence of construction, repair or alteration."@en .


###  https://wanqin-liu.github.io/ahkto/hasArchitecturalStyle
:hasArchitecturalStyle rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                       owl:inverseOf :isArchitecturalStyleOf ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :ArchitecturalElement
                                                   :Building
                                                 )
                                   ] ;
                       rdfs:range :ArchitecturalStyle ;
                       rdfs:label "has architectural style"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "This property relates a building or an architectural element to an architectural style that characterises its formal composition, design principles, or decorative expression. Different architectural styles may be associated with the same building or element, reflecting stylistic variations, historical alterations, or later interventions. The assignment represents a stylistic classification and does not necessarily indicate the date of construction.."@en .


###  https://wanqin-liu.github.io/ahkto/hasBuildingType
:hasBuildingType rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                 owl:inverseOf :isBuildingTypeOf ;
                 rdfs:domain :Building ;
                 rdfs:range :BuildingType ;
                 rdfs:label "has building type"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Classifies a building according to its use, function or architectural organisation."@en .


###  https://wanqin-liu.github.io/ahkto/hasClassicalOrder
:hasClassicalOrder rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                   owl:inverseOf :isClassicalOrderOf ;
                   rdfs:domain :ArchitecturalElement ;
                   rdfs:range :ClassicalOrder ;
                   rdfs:label "has classical order"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "This property relates an architectural element to a classical architectural order identified through its formal characteristics, proportions, and decorative details. It supports the classification of elements associated with the Doric, Ionic, Corinthian, Tuscan, or Composite orders, including columns, pilasters, capitals, and entablatures. The assignment reflects the architectural characteristics of the element and does not necessarily imply that it belongs to a complete classical order system."@en .


###  https://wanqin-liu.github.io/ahkto/hasComponentID
:hasComponentID rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by> ;
                owl:inverseOf :isComponentIDOf ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing>
                                            <http://www.cidoc-crm.org/cidoc-crm/E53_Place>
                                          )
                            ] ;
                rdfs:range :ComponentID ;
                rdfs:label "has component id"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Associates an instance of E24 Physical Human-Made Thing or E53 Place with a component identifier assigned within a particular recording system. In AHKTO this covers physical architectural entities and spatial entities; the domain is the union of the two CRM classes."@en .


###  https://wanqin-liu.github.io/ahkto/hasConstructionTechnique
:hasConstructionTechnique rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                          owl:inverseOf :isConstructionTechniqueOf ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :ArchitecturalElement
                                                      :ArchitecturalStratigraphicUnit
                                                      :Building
                                                      :ConstructionalLayer
                                                      :DiscreteBuildingUnit
                                                    )
                                      ] ;
                          rdfs:range :ConstructionTechnique ;
                          rdfs:label "has construction technique"@en ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Records a construction technique used to form or assemble a building, architectural element, architectural stratigraphic unit, constructional layer or discrete building unit."@en .


###  https://wanqin-liu.github.io/ahkto/hasConstructionalLayer
:hasConstructionalLayer rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
                        owl:inverseOf :isConstructionalLayerOf ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :ArchitecturalElement
                                                    :ArchitecturalStratigraphicUnit
                                                  )
                                    ] ;
                        rdfs:range :ConstructionalLayer ;
                        rdfs:label "has constructional layer"@en ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies a material layer within an element or a stratigraphic unit. Use evidence of position, fabric or function to distinguish the layer."@en .


###  https://wanqin-liu.github.io/ahkto/hasDecorativeFeature
:hasDecorativeFeature rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
                      owl:inverseOf :isDecorativeFeatureOf ;
                      rdfs:domain :ArchitecturalElement ;
                      rdfs:range :ArchitecturalDecorativeFeature ;
                      rdfs:label "has decorative feature"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies decoration executed on or in the material of an element and dependent on that support."@en .


###  https://wanqin-liu.github.io/ahkto/hasDiscreteBuildingUnit
:hasDiscreteBuildingUnit rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
                         owl:inverseOf :isDiscreteBuildingUnitOf ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :ArchitecturalElement
                                                     :ArchitecturalStratigraphicUnit
                                                     :ConstructionalLayer
                                                   )
                                     ] ;
                         rdfs:range :DiscreteBuildingUnit ;
                         rdfs:label "has discrete building unit"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies an individual piece of construction fabric within any of the three stated domains. Multiple descriptions may refer to the same physical unit."@en .


###  https://wanqin-liu.github.io/ahkto/hasDomeType
:hasDomeType rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
             owl:inverseOf :isDomeTypeOf ;
             rdfs:domain :Dome ;
             rdfs:range :DomeType ;
             rdfs:label "has dome type"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Assigns a form or construction category to an individual dome."@en .


###  https://wanqin-liu.github.io/ahkto/hasElement
:hasElement rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
            owl:inverseOf :isElementOf ;
            rdfs:domain :Building ;
            rdfs:range :ArchitecturalElement ;
            rdfs:label "has element"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates a building to a physical element of its fabric. Record the host building even when the element also bounds two spaces."@en .


###  https://wanqin-liu.github.io/ahkto/hasInformationResource
:hasInformationResource rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> ;
                        owl:inverseOf :isInformationResourceOf ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing>
                                                    <http://www.cidoc-crm.org/cidoc-crm/E53_Place>
                                                  )
                                    ] ;
                        rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
                        rdfs:label "has information resource"@en ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> """This property associates an identifiable physical human-made thing or place with an information resource that refers to, describes, documents, depicts, or otherwise provides information concerning it.

The property supports the association of architectural heritage and its constituent components or spatial locations with heterogeneous information resources, including textual documents, photographs, drawings, audio recordings, videos, point clouds, geometric models, and building information models.

The association is independent of the information resource's medium, format, production technique, temporal coverage, or documentary purpose. Information resources may concern existing conditions, historical configurations, conservation activities, proposed designs, or hypothetical reconstructions.

This property establishes a general semantic association between a physical human-made thing or place and an information resource. It does not imply that the information resource provides an accurate representation of the current physical state of the referenced subject, nor does it establish the historical validity of the information it contains. More specific relationships may be expressed through additional properties where necessary."""@en .


###  https://wanqin-liu.github.io/ahkto/hasMasonryUnitType
:hasMasonryUnitType rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                    owl:inverseOf :isMasonryUnitTypeOf ;
                    rdfs:domain :MasonryUnit ;
                    rdfs:range :MasonryUnitType ;
                    rdfs:label "has masonry unit type"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Classifies an individual masonry unit by its manufacture, form or constructional use."@en .


###  https://wanqin-liu.github.io/ahkto/hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> ;
         owl:inverseOf :isPartOf ;
         rdfs:domain :ArchitecturalElement ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :ArchitecturalElement
                                    :SculptureObject
                                  )
                    ] ;
         rdfs:label "has part"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates an element to a constituent element or an incorporated sculpture. Installation as part of the host distinguishes this relation from the presence of an object in the same room."@en .


###  https://wanqin-liu.github.io/ahkto/hasStorey
:hasStorey rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P59_has_section> ;
           owl:inverseOf :isStoreyOf ;
           rdfs:domain :Building ;
           rdfs:range :Storey ;
           rdfs:label "has storey"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies a level within the vertical organisation of a building."@en .


###  https://wanqin-liu.github.io/ahkto/hasVaultType
:hasVaultType rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
              owl:inverseOf :isVaultTypeOf ;
              rdfs:domain :Vault ;
              rdfs:range :VaultType ;
              rdfs:label "has vault type"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Assigns a geometric or structural category to an individual vault."@en .


###  https://wanqin-liu.github.io/ahkto/intersectsArchitecturalSpace
:intersectsArchitecturalSpace rdf:type owl:ObjectProperty ;
                              rdfs:domain :ArchitecturalElement ;
                              rdfs:range :ArchitecturalSpace ;
                              rdfs:label "intersects architectural space"@en ;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates an architectural element to a space when the element crosses the spatial boundary and extends into the interior."@en .


###  https://wanqin-liu.github.io/ahkto/intersectsElement
:intersectsElement rdf:type owl:ObjectProperty ;
                   owl:inverseOf :intersectsArchitecturalSpace ;
                   rdfs:domain :ArchitecturalSpace ;
                   rdfs:range :ArchitecturalElement ;
                   rdfs:label "intersects element"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates a space to an architectural element whose physical volume crosses the boundary of the space and extends into its interior."@en .


###  https://wanqin-liu.github.io/ahkto/intersectsWith
:intersectsWith rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P121_overlaps_with> ;
                rdf:type owl:SymmetricProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :ArchitecturalSpace
                                            :Storey
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :ArchitecturalSpace
                                           :Storey
                                         )
                           ] ;
                rdfs:label "intersects with"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Relates two spatial extents whose interiors overlap. Either extent may be an architectural space or a storey. The relation reads in both directions."@en .


###  https://wanqin-liu.github.io/ahkto/isArchTypeOf
:isArchTypeOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
              rdfs:domain :ArchType ;
              rdfs:range :Arch ;
              rdfs:label "is arch type of"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasArchType. Read from the object to the subject: Assigns a form or construction category to an individual arch."@en .


###  https://wanqin-liu.github.io/ahkto/isArchitecturalDecorationTypeOf
:isArchitecturalDecorationTypeOf rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
                                 rdfs:domain :ArchitecturalDecorationType ;
                                 rdfs:range :ArchitecturalDecorativeFeature ;
                                 rdfs:label "is architectural decoration type of"@en ;
                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasArchitecturalDecorationType. Read from the object to the subject: Classifies a decorative feature by a recorded aspect of its medium, form or motif."@en .


###  https://wanqin-liu.github.io/ahkto/isArchitecturalSpaceOf
:isArchitecturalSpaceOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P59i_is_located_on_or_within> ;
                        rdfs:domain :ArchitecturalSpace ;
                        rdfs:range :Building ;
                        rdfs:label "is architectural space of"@en ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasArchitecturalSpace. Read from the object to the subject: Relates a building to an identifiable architectural space belonging to it. This relation can describe a space extending across several storeys."@en .


###  https://wanqin-liu.github.io/ahkto/isArchitecturalStratigraphicUnitOf
:isArchitecturalStratigraphicUnitOf rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> ;
                                    rdfs:domain :ArchitecturalStratigraphicUnit ;
                                    rdfs:range :ArchitecturalElement ;
                                    rdfs:label "is architectural stratigraphic unit of"@en ;
                                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasArchitecturalStratigraphicUnit. Read from the object to the subject: Relates an element to a recognisable portion of its fabric interpreted as evidence of construction, repair or alteration."@en .


###  https://wanqin-liu.github.io/ahkto/isArchitecturalStyleOf
:isArchitecturalStyleOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
                        rdfs:domain :ArchitecturalStyle ;
                        rdfs:range [ rdf:type owl:Class ;
                                     owl:unionOf ( :ArchitecturalElement
                                                   :Building
                                                 )
                                   ] ;
                        rdfs:label "is architectural style of"@en ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasArchitecturalStyle. Read from the object to the subject: This property relates a building or an architectural element to an architectural style that characterises its formal composition, design principles, or decorative expression. Different architectural styles may be associated with the same building or element, reflecting stylistic variations, historical alterations, or later interventions. The assignment represents a stylistic classification and does not necessarily indicate the date of construction.."@en .


###  https://wanqin-liu.github.io/ahkto/isBoundedBy
:isBoundedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :bounds ;
             rdfs:domain :ArchitecturalSpace ;
             rdfs:range :ArchitecturalElement ;
             rdfs:label "is bounded by"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies an element that defines part of a space’s boundary. An open or partially enclosed space can have recorded boundaries."@en .


###  https://wanqin-liu.github.io/ahkto/isBuildingTypeOf
:isBuildingTypeOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
                  rdfs:domain :BuildingType ;
                  rdfs:range :Building ;
                  rdfs:label "is building type of"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasBuildingType. Read from the object to the subject: Classifies a building according to its use, function or architectural organisation."@en .


###  https://wanqin-liu.github.io/ahkto/isClassicalOrderOf
:isClassicalOrderOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
                    rdfs:domain :ClassicalOrder ;
                    rdfs:range :ArchitecturalElement ;
                    rdfs:label "is classical order of"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasClassicalOrder. Read from the object to the subject: This property relates an architectural element to a classical architectural order identified through its formal characteristics, proportions, and decorative details. It supports the classification of elements associated with the Doric, Ionic, Corinthian, Tuscan, or Composite orders, including columns, pilasters, capitals, and entablatures. The assignment reflects the architectural characteristics of the element and does not necessarily imply that it belongs to a complete classical order system."@en .


###  https://wanqin-liu.github.io/ahkto/isComponentIDOf
:isComponentIDOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P1i_identifies> ;
                 rdfs:domain :ComponentID ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing>
                                            <http://www.cidoc-crm.org/cidoc-crm/E53_Place>
                                          )
                            ] ;
                 rdfs:label "is component id of"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasComponentID. Read from the object to the subject: Associates an instance of E24 Physical Human-Made Thing or E53 Place with a component identifier assigned within a particular recording system. In AHKTO this covers physical architectural entities and spatial entities; the domain is the union of the two CRM classes."@en .


###  https://wanqin-liu.github.io/ahkto/isConstructionTechniqueOf
:isConstructionTechniqueOf rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
                           rdfs:domain :ConstructionTechnique ;
                           rdfs:range [ rdf:type owl:Class ;
                                        owl:unionOf ( :ArchitecturalElement
                                                      :ArchitecturalStratigraphicUnit
                                                      :Building
                                                      :ConstructionalLayer
                                                      :DiscreteBuildingUnit
                                                    )
                                      ] ;
                           rdfs:label "is construction technique of"@en ;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasConstructionTechnique. Read from the object to the subject: Records a construction technique used to form or assemble a building, architectural element, architectural stratigraphic unit, constructional layer or discrete building unit."@en .


###  https://wanqin-liu.github.io/ahkto/isConstructionalLayerOf
:isConstructionalLayerOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> ;
                         rdfs:domain :ConstructionalLayer ;
                         rdfs:range [ rdf:type owl:Class ;
                                      owl:unionOf ( :ArchitecturalElement
                                                    :ArchitecturalStratigraphicUnit
                                                  )
                                    ] ;
                         rdfs:label "is constructional layer of"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasConstructionalLayer. Read from the object to the subject: Identifies a material layer within an element or a stratigraphic unit. Use evidence of position, fabric or function to distinguish the layer."@en .


###  https://wanqin-liu.github.io/ahkto/isContainedAsASculptureIn
:isContainedAsASculptureIn rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location> ;
                           rdfs:domain :SculptureObject ;
                           rdfs:range :ArchitecturalSpace ;
                           rdfs:label "is contained as a sculpture in"@en ;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies the architectural space in which a sculpture object is located."@en .


###  https://wanqin-liu.github.io/ahkto/isContainedAsAnArchitecturalSpaceIn
:isContainedAsAnArchitecturalSpaceIn rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P89_falls_within> ;
                                     rdfs:domain :ArchitecturalSpace ;
                                     rdfs:range :Storey ;
                                     rdfs:label "is contained as an architectural space in"@en ;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies the storey within whose spatial extent an architectural space lies."@en .


###  https://wanqin-liu.github.io/ahkto/isContainedAsAnElementIn
:isContainedAsAnElementIn rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location> ;
                          rdfs:domain :ArchitecturalElement ;
                          rdfs:range :ArchitecturalSpace ;
                          rdfs:label "is contained as an element in"@en ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifies the architectural space containing an architectural element."@en .


###  https://wanqin-liu.github.io/ahkto/isDecorativeFeatureOf
:isDecorativeFeatureOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> ;
                       rdfs:domain :ArchitecturalDecorativeFeature ;
                       rdfs:range :ArchitecturalElement ;
                       rdfs:label "is decorative feature of"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasDecorativeFeature. Read from the object to the subject: Identifies decoration executed on or in the material of an element and dependent on that support."@en .


###  https://wanqin-liu.github.io/ahkto/isDiscreteBuildingUnitOf
:isDiscreteBuildingUnitOf rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> ;
                          rdfs:domain :DiscreteBuildingUnit ;
                          rdfs:range [ rdf:type owl:Class ;
                                       owl:unionOf ( :ArchitecturalElement
                                                     :ArchitecturalStratigraphicUnit
                                                     :ConstructionalLayer
                                                   )
                                     ] ;
                          rdfs:label "is discrete building unit of"@en ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasDiscreteBuildingUnit. Read from the object to the subject: Identifies an individual piece of construction fabric within any of the three stated domains. Multiple descriptions may refer to the same physical unit."@en .


###  https://wanqin-liu.github.io/ahkto/isDomeTypeOf
:isDomeTypeOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
              rdfs:domain :DomeType ;
              rdfs:range :Dome ;
              rdfs:label "is dome type of"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasDomeType. Read from the object to the subject: Assigns a form or construction category to an individual dome."@en .


###  https://wanqin-liu.github.io/ahkto/isElementOf
:isElementOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> ;
             rdfs:domain :ArchitecturalElement ;
             rdfs:range :Building ;
             rdfs:label "is element of"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasElement. Read from the object to the subject: Relates a building to a physical element of its fabric. Record the host building even when the element also bounds two spaces."@en .


###  https://wanqin-liu.github.io/ahkto/isInformationResourceOf
:isInformationResourceOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67_refers_to> ;
                         rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
                         rdfs:range [ rdf:type owl:Class ;
                                      owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing>
                                                    <http://www.cidoc-crm.org/cidoc-crm/E53_Place>
                                                  )
                                    ] ;
                         rdfs:label "is information resource of"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the inverse of ahkto: has information resource. It associates an information resource with a physical human-made thing or place that the resource refers to, describes, documents, depicts or otherwise concerns. It carries the same qualifications concerning representation, accuracy and historical validity as the forward property."@en .


###  https://wanqin-liu.github.io/ahkto/isMasonryUnitTypeOf
:isMasonryUnitTypeOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
                     rdfs:domain :MasonryUnitType ;
                     rdfs:range :MasonryUnit ;
                     rdfs:label "is masonry unit type of"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasMasonryUnitType. Read from the object to the subject: Classifies an individual masonry unit by its manufacture, form or constructional use."@en .


###  https://wanqin-liu.github.io/ahkto/isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :ArchitecturalElement
                                      :SculptureObject
                                    )
                      ] ;
          rdfs:range :ArchitecturalElement ;
          rdfs:label "is part of"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasPart. Read from the object to the subject: Relates an element to a constituent element or an incorporated sculpture. Installation as part of the host distinguishes this relation from the presence of an object in the same room."@en .


###  https://wanqin-liu.github.io/ahkto/isStoreyOf
:isStoreyOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P59i_is_located_on_or_within> ;
            rdfs:domain :Storey ;
            rdfs:range :Building ;
            rdfs:label "is storey of"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasStorey. Read from the object to the subject: Identifies a level within the vertical organisation of a building."@en .


###  https://wanqin-liu.github.io/ahkto/isVaultTypeOf
:isVaultTypeOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
               rdfs:domain :VaultType ;
               rdfs:range :Vault ;
               rdfs:label "is vault type of"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of ahkto:hasVaultType. Read from the object to the subject: Assigns a geometric or structural category to an individual vault."@en .


#################################################################
#    Classes
#################################################################

###  https://wanqin-liu.github.io/ahkto/Acroteria
:Acroteria rdf:type owl:Class ;
           rdfs:subClassOf :ArchitecturalElement ;
           rdfs:label "Acroteria"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "An ornament placed at the summit or at a lower corner of a pediment. Each ornament can be recorded individually, whether it takes the form of foliage, a figure or another sculptural motif."@en ;
           :hasAATReference <http://vocab.getty.edu/aat/300002214> .


###  https://wanqin-liu.github.io/ahkto/Aedicules
:Aedicules rdf:type owl:Class ;
           rdfs:subClassOf :ArchitecturalAssemblies ;
           rdfs:label "Aedicules"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "A small shrine or architectural frame that gives a niche, image or opening the form of a miniature building. Supports and a crowning member define the frame."@en ;
           :hasAATReference <http://vocab.getty.edu/aat/300002574> .


###  https://wanqin-liu.github.io/ahkto/Arch
:Arch rdf:type owl:Class ;
      rdfs:subClassOf :ArchitecturalElement ;
      rdfs:label "Arch"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "A curved or pointed construction spanning an opening and transmitting load to supports at its springings. Its constituent voussoirs may be recorded individually."@en ;
      :hasAATReference <http://vocab.getty.edu/aat/300000994> .


###  https://wanqin-liu.github.io/ahkto/ArchType
:ArchType rdf:type owl:Class ;
          rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
          rdfs:label "Arch Type"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A controlled concept used to classify an arch by a stated criterion such as profile or construction."@en .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalAssemblies
:ArchitecturalAssemblies rdf:type owl:Class ;
                         rdfs:subClassOf :ArchitecturalElement ;
                         rdfs:label "Architectural Assemblies"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "An arrangement of architectural elements identifiable as a single composition. Its identity depends on how the members work together, even where individual elements also have records."@en .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalDecorationType
:ArchitecturalDecorationType rdf:type owl:Class ;
                             rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
                             rdfs:label "Architectural Decoration Type"@en ;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "A controlled concept classifying an architectural decorative feature by its form, medium or motif. The same concept may describe decorative features on different supporting elements."@en .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalDecorativeFeature
:ArchitecturalDecorativeFeature rdf:type owl:Class ;
                                rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E25_Human-Made_Feature> ;
                                rdfs:label "Architectural Decorative Feature"@en ;
                                <http://www.w3.org/2004/02/skos/core#scopeNote> """This class comprises identifiable decorative features intentionally created on or within architectural elements through human activity. Such features are physically integrated with their supporting architectural elements and cannot be separated from them without altering their physical integrity.

Instances of this class may include figurative paintings, frescoes, graffiti, carved reliefs, ornamental motifs, decorative moldings, and modeled stucco decorations executed directly on architectural surfaces. These features may serve aesthetic, artistic, symbolic, or iconographic purposes and do not necessarily perform a structural function."""@en ;
                                :hasAATReference <http://vocab.getty.edu/aat/300378995> .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalElement
:ArchitecturalElement rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing> ;
                      rdfs:label "Architectural Element"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "A physically identifiable element of an architectural work, distinguished by its architectural form, function, or constructional characteristics, whether or not it constitutes an independently manufactured or assembled unit."@en ;
                      :hasAATReference <http://vocab.getty.edu/aat/300000885> .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalSpace
:ArchitecturalSpace rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E53_Place> ;
                    rdfs:label "Architectural Space"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> """This class comprises identifiable spatial regions within or associated with architectural works, defined by their architectural configuration, spatial boundaries, or architectural functions. Instances of this class may be enclosed, partially enclosed, or open spaces, including rooms, halls, corridors, naves, chapels, and courtyards.

An architectural space may be defined or bounded by one or more architectural elements, such as walls, columns, floors, and vaults. The spatial extent of an architectural space may overlap with the physical volume occupied by architectural elements, depending on how its boundaries are defined. Architectural spaces may contain physical objects, including furniture, sculptures, and other movable or immovable objects.

Instances of this class may be associated with a building as a whole or with a particular storey. They may also extend across multiple storeys and have spatial relationships with other architectural spaces, such as adjacency and containment."""@en ;
                    :hasAATReference <http://vocab.getty.edu/aat/300420294> .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalStratigraphicUnit
:ArchitecturalStratigraphicUnit rdf:type owl:Class ;
                                rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing> ;
                                rdfs:label "Architectural Stratigraphic Unit"@en ;
                                <http://www.w3.org/2004/02/skos/core#scopeNote> """This class comprises physically identifiable portions of historic buildings formed through distinguishable episodes of human construction, reconstruction, modification, or repair. Each instance represents a stratigraphically coherent physical unit, which may consist of multiple materials or construction elements, with recognizable boundaries or discontinuities that distinguish it from adjacent building fabric and provide evidence of its formation history.

Instances may remain physically integrated with the surrounding building fabric while retaining a distinct stratigraphic identity. Their identification does not necessarily require a precise date or attribution to a known historical event."""@en .


###  https://wanqin-liu.github.io/ahkto/ArchitecturalStyle
:ArchitecturalStyle rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
                    rdfs:label "Architectural Style"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises controlled concepts used to classify buildings, architectural elements, architectural stratigraphic units, constructional layers and discrete building units according to characteristic formal, compositional and decorative features associated with recognised architectural styles or historical traditions. Stylistic categories may be identified through architectural design, proportions, ornamentation and other morphological characteristics. An entity may be associated with multiple architectural styles where construction, modification or restoration reflects different stylistic influences."@en .


###  https://wanqin-liu.github.io/ahkto/Architrave
:Architrave rdf:type owl:Class ;
            rdfs:subClassOf :ArchitecturalElement ;
            rdfs:label "Architrave"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "In the context of a classical entablature, the lowermost horizontal division immediately above the supports."@en ;
            :hasAATReference <http://vocab.getty.edu/aat/300001780> .


###  https://wanqin-liu.github.io/ahkto/Ashlar
:Ashlar rdf:type owl:Class ;
        rdfs:subClassOf :DiscreteBuildingUnit ;
        rdfs:label "Ashlar"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "An individual dressed building stone with accurately worked bedding and joint faces. Here the record identifies a block within the masonry."@en ;
        :hasAATReference <http://vocab.getty.edu/aat/300011701> .


###  https://wanqin-liu.github.io/ahkto/Audio
:Audio rdf:type owl:Class ;
       rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
       rdfs:label "Audio"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable information resources whose content is primarily expressed through sound. It includes audio recordings, oral histories, interviews, spoken narratives, and environmental or architectural sound recordings associated with built heritage. Audio resources may document actual events and existing conditions, communicate historical interpretations, or present proposed experiences and narratives. The class is defined by its auditory form rather than its documentary purpose, linguistic content, recording technology, or digital file format."@en ;
       :hasAATReference <http://vocab.getty.edu/aat/300028633> .


###  https://wanqin-liu.github.io/ahkto/BIMModel
:BIMModel rdf:type owl:Class ;
          rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
          rdfs:label "BIM Model"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable digital building information resources that organize architectural and construction-related information through structured representations of buildings, their components, attributes, and relationships. BIM models may integrate geometric representations with semantic descriptions, material information, spatial organization, and other building-related data. They may describe existing buildings, proposed designs, historical reconstructions, or conservation interventions. The class includes Heritage Building Information Models (HBIM) and is independent of a particular authoring application, exchange format, or geometric representation method. Unlike a purely geometric model, a BIM model provides an explicit information structure for representing building elements and their associated properties and relationships."@en .


###  https://wanqin-liu.github.io/ahkto/Building
:Building rdf:type owl:Class ;
          rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing> ;
          rdfs:label "Building"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises physically constructed buildings that form identifiable architectural wholes, consisting of interconnected architectural elements and enclosing or organising spaces. A building may contain multiple storeys and architectural spaces and retains its identity despite changes in function or internal spatial organisation."@en ;
          :hasAATReference <http://vocab.getty.edu/aat/300004792> .


###  https://wanqin-liu.github.io/ahkto/BuildingType
:BuildingType rdf:type owl:Class ;
              rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
              rdfs:label "Building Type"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises controlled concepts used to classify buildings according to their intended function, historical or current use, or architectural organization. Instances of this class may describe functional or typological categories, and a building may be assigned multiple types or different classifications over time as its use or interpretation changes."@en .


###  https://wanqin-liu.github.io/ahkto/ClassicalOrder
:ClassicalOrder rdf:type owl:Class ;
                rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
                rdfs:label "Classical Order"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises controlled concepts representing classical architectural orders used to classify architectural elements according to their formal and stylistic characteristics. The five orders considered are Doric, Ionic, Corinthian, Tuscan, and Composite. These concepts are identified using Getty Art & Architecture Thesaurus (AAT) URIs."@en ;
                :hasAATReference <http://vocab.getty.edu/aat/300404750> .


###  https://wanqin-liu.github.io/ahkto/Column
:Column rdf:type owl:Class ;
        rdfs:subClassOf :ArchitecturalElement ;
        rdfs:label "Column"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "An upright architectural member with a shaft, used to carry a load or to express support. The shaft, capital and any base may be identified individually."@en ;
        :hasAATReference <http://vocab.getty.edu/aat/300001571> .


###  https://wanqin-liu.github.io/ahkto/ColumnBase
:ColumnBase rdf:type owl:Class ;
            rdfs:subClassOf :ArchitecturalElement ;
            rdfs:label "Column Base"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "The lower member on which a column shaft stands. Plinths and mouldings may be recorded as parts where survey resolution permits."@en ;
            :hasAATReference <http://vocab.getty.edu/aat/300233843> .


###  https://wanqin-liu.github.io/ahkto/ColumnCapital
:ColumnCapital rdf:type owl:Class ;
               rdfs:subClassOf :ArchitecturalElement ;
               rdfs:label "Column Capital"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "The upper member of a column, at the transition from shaft to the element above. The capital may provide evidence for assigning a classical order."@en ;
               :hasAATReference <http://vocab.getty.edu/aat/300001662> .


###  https://wanqin-liu.github.io/ahkto/ColumnShaft
:ColumnShaft rdf:type owl:Class ;
             rdfs:subClassOf :ArchitecturalElement ;
             rdfs:label "Column Shaft"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The main upright body of a column between its foot and capital. A shaft can consist of several drums while remaining one architectural element."@en ;
             :hasAATReference <http://vocab.getty.edu/aat/300001754> .


###  https://wanqin-liu.github.io/ahkto/ComponentID
:ComponentID rdf:type owl:Class ;
             rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E42_Identifier> ;
             rdfs:label "Component ID"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "An identifier assigned to distinguish a particular architectural entity within a survey, inventory or information system. The same component may carry identifiers from more than one scheme."@en .


###  https://wanqin-liu.github.io/ahkto/ConstructionTechnique
:ConstructionTechnique rdf:type owl:Class ;
                       rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
                       rdfs:label "Construction Technique"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "A controlled concept denoting a method of assembling, shaping or applying building fabric. The same technique can classify work undertaken at different dates."@en ;
                       :hasAATReference <http://vocab.getty.edu/aat/300379526> .


###  https://wanqin-liu.github.io/ahkto/ConstructionalLayer
:ConstructionalLayer rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing> ;
                     rdfs:label "Constructional Layer"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "A physically identifiable layer of an architectural element, distinguished by its material composition, constructional function, or position within a layered assembly. It may constitute a structural, protective, or finishing layer and can be identified as a distinct physical part regardless of whether it was formed through a single or multiple construction activities."@en .


###  https://wanqin-liu.github.io/ahkto/Cornice
:Cornice rdf:type owl:Class ;
         rdfs:subClassOf :ArchitecturalElement ;
         rdfs:label "Cornice"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "A projecting horizontal member that crowns an entablature or terminates a wall. The projection may also throw rainwater clear of the surface below."@en ;
         :hasAATReference <http://vocab.getty.edu/aat/300001788> .


###  https://wanqin-liu.github.io/ahkto/DiscreteBuildingUnit
:DiscreteBuildingUnit rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E24_Physical_Human-Made_Thing> ;
                      rdfs:label "Discrete Building Unit"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "An individually distinguishable piece of building fabric used in construction or assembly. Its physical boundaries allow the same piece to be followed through reuse or displacement."@en .


###  https://wanqin-liu.github.io/ahkto/Dome
:Dome rdf:type owl:Class ;
      rdfs:subClassOf :ArchitecturalElement ;
      rdfs:label "Dome"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "A curved covering rising above a space around a central area or axis. This class identifies the physical covering, including domes formed by several shells."@en ;
      :hasAATReference <http://vocab.getty.edu/aat/300001280> .


###  https://wanqin-liu.github.io/ahkto/DomeType
:DomeType rdf:type owl:Class ;
          rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
          rdfs:label "Dome Type"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A controlled concept used to classify domes by form or construction. The classification can describe a shell arrangement independently of its material."@en .


###  https://wanqin-liu.github.io/ahkto/Drawing
:Drawing rdf:type owl:Class ;
         rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
         rdfs:label "Drawing"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable graphical information resources that represent architectural forms, spatial configurations, dimensions, construction details, or design concepts through lines, symbols, annotations, and other graphic conventions. It includes manually produced and computer-aided drawings, such as architectural plans, elevations, sections, measured survey drawings, technical drawings, and reconstruction drawings. Drawings may document existing or historical conditions, communicate design proposals, or express hypothetical interpretations of architectural structures. The class concerns the informational content of drawings, independently of their production technique, physical support, or digital format. Two-dimensional CAD drawings are included, whereas three-dimensional geometric models are represented separately."@en ;
         :hasAATReference <http://vocab.getty.edu/aat/300033973> ,
                          <http://vocab.getty.edu/aat/300034395> ,
                          <http://vocab.getty.edu/aat/300034787> .


###  https://wanqin-liu.github.io/ahkto/EngagedColumn
:EngagedColumn rdf:type owl:Class ;
               rdfs:subClassOf :ArchitecturalElement ;
               rdfs:label "Engaged Column"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A column whose shaft projects from and is partly embedded in a wall or pier. Its exposed shaft retains the profile of a column."@en ;
               :hasAATReference <http://vocab.getty.edu/aat/300001638> .


###  https://wanqin-liu.github.io/ahkto/Entablature
:Entablature rdf:type owl:Class ;
             rdfs:subClassOf :ArchitecturalElement ;
             rdfs:label "Entablature"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The horizontal superstructure of a classical order. Its architrave, frieze and cornice can be recorded individually even where they are cut from the same stone."@en ;
             :hasAATReference <http://vocab.getty.edu/aat/300001770> .


###  https://wanqin-liu.github.io/ahkto/Facade
:Facade rdf:type owl:Class ;
        rdfs:subClassOf :ArchitecturalAssemblies ;
        rdfs:label "Facade"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "The exterior face of a building considered as a composed whole, including its openings, divisions and applied elements. Each elevation may be documented separately."@en ;
        :hasAATReference <http://vocab.getty.edu/aat/300002526> .


###  https://wanqin-liu.github.io/ahkto/FinalRender
:FinalRender rdf:type owl:Class ;
             rdfs:subClassOf :ConstructionalLayer ;
             rdfs:label "Final Render"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The outer finishing coat of a render system. The surface may be worked or coloured, while the coat remains identifiable by its position and material extent."@en .


###  https://wanqin-liu.github.io/ahkto/Frieze
:Frieze rdf:type owl:Class ;
        rdfs:subClassOf :ArchitecturalElement ;
        rdfs:label "Frieze"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "The middle division of an entablature, between architrave and cornice. Surface carving may be recorded as a decorative feature of the frieze."@en ;
        :hasAATReference <http://vocab.getty.edu/aat/300001816> .


###  https://wanqin-liu.github.io/ahkto/GeometricModel
:GeometricModel rdf:type owl:Class ;
                rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
                rdfs:label "Geometric Model"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable digital information resources that represent the three-dimensional geometry of physical or conceptual objects through explicit or mathematically defined geometric structures. Such representations may include polygonal meshes, boundary representations, NURBS curves and surfaces, solid models, and parametric geometric models. Geometric models may describe surveyed architectural conditions, document historical configurations, support hypothetical reconstructions, or communicate design proposals. The class emphasizes geometric representation and does not require the explicit semantic classification of architectural components or the information structures characteristic of Building Information Modeling."@en .


###  https://wanqin-liu.github.io/ahkto/Keystone
:Keystone rdf:type owl:Class ;
          rdfs:subClassOf :DiscreteBuildingUnit ;
          rdfs:label "Keystone"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "The crown unit closing an arch or a corresponding convergence of vault members. Record its position in the arch separately from any carving on its exposed face."@en ;
          :hasAATReference <http://vocab.getty.edu/aat/300001183> .


###  https://wanqin-liu.github.io/ahkto/LevellingCoat
:LevellingCoat rdf:type owl:Class ;
               rdfs:subClassOf :ConstructionalLayer ;
               rdfs:label "Levelling Coat"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A preparatory coat applied to fill irregularities and establish a plane for a later finish. Its position beneath that finish helps identify it in an exposed section."@en .


###  https://wanqin-liu.github.io/ahkto/MasonryLayer
:MasonryLayer rdf:type owl:Class ;
              rdfs:subClassOf :ConstructionalLayer ;
              rdfs:label "Masonry Layer"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "A coherent thickness of masonry within a larger element, distinguished by its position or construction. A layer can include numerous stones or bricks and their joints."@en .


###  https://wanqin-liu.github.io/ahkto/MasonryUnit
:MasonryUnit rdf:type owl:Class ;
             rdfs:subClassOf :DiscreteBuildingUnit ;
             rdfs:label "Masonry Unit"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "An individual stone, brick or block laid as a constituent of masonry. A record identifies one unit even when many units share the same manufactured type."@en ;
             :hasAATReference <http://vocab.getty.edu/aat/300159910> .


###  https://wanqin-liu.github.io/ahkto/MasonryUnitType
:MasonryUnitType rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
                 rdfs:label "Masonry Unit Type"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A controlled concept for classifying individual masonry units by form, manufacture or constructional use."@en .


###  https://wanqin-liu.github.io/ahkto/Niche
:Niche rdf:type owl:Class ;
       rdfs:subClassOf :ArchitecturalElement ;
       rdfs:label "Niche"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "A recess formed in the face of a wall or another architectural element. Its back and sides define a distinct feature that may be recorded independently of any object displayed inside it."@en ;
       :hasAATReference <http://vocab.getty.edu/aat/300002704> .


###  https://wanqin-liu.github.io/ahkto/Pediment
:Pediment rdf:type owl:Class ;
          rdfs:subClassOf :ArchitecturalElement ;
          rdfs:label "Pediment"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A crowning element in the form of a gable above a portico, doorway or window. A pediment can be triangular, curved or broken. It includes the framing cornices and the field they enclose."@en ;
          :hasAATReference <http://vocab.getty.edu/aat/300002726> .


###  https://wanqin-liu.github.io/ahkto/Photograph
:Photograph rdf:type owl:Class ;
            rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
            rdfs:label "Photograph"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable information resources consisting of still photographic images produced through photographic processes, including analog and digital photography and the digitization of photographic originals. It includes historical photographs, contemporary survey photographs, detailed architectural photographs, and photographic documentation of construction and conservation activities. Photographs may depict existing architectural conditions, historical states, physical models, or proposed architectural designs. The class refers to photographic information content independently of its physical or digital carrier, file format, documentary function, or interpretation."@en ;
            :hasAATReference <http://vocab.getty.edu/aat/300046300> .


###  https://wanqin-liu.github.io/ahkto/Pier
:Pier rdf:type owl:Class ;
      rdfs:subClassOf :ArchitecturalElement ;
      rdfs:label "Pier"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "A substantial upright support that carries the loads of an arch, vault or beam down to its footing. Its cross-section may be compound or polygonal."@en ;
      :hasAATReference <http://vocab.getty.edu/aat/300000953> .


###  https://wanqin-liu.github.io/ahkto/Pilaster
:Pilaster rdf:type owl:Class ;
          rdfs:subClassOf :ArchitecturalElement ;
          rdfs:label "Pilaster"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A shallow rectangular upright projecting from a wall face, often articulated with a base and capital. Its visible form can express an order even where the wall carries the load."@en ;
          :hasAATReference <http://vocab.getty.edu/aat/300002737> .


###  https://wanqin-liu.github.io/ahkto/PointCloud
:PointCloud rdf:type owl:Class ;
            rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
            rdfs:label "Point Cloud"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable digital information resources representing three-dimensional spatial information through collections of discrete points defined by spatial coordinates and, where available, additional attributes such as color, intensity, or surface classification. Point clouds may be generated through terrestrial laser scanning, photogrammetry, or other spatial data acquisition and processing techniques. They may represent surveyed architectural conditions, reconstructed historical configurations, or digitally generated design geometries. The class is distinguished from surface-based or parametric geometric models by its point-based spatial representation and is independent of the file format or acquisition method."@en .


###  https://wanqin-liu.github.io/ahkto/Roof
:Roof rdf:type owl:Class ;
      rdfs:subClassOf :ArchitecturalElement ;
      rdfs:label "Roof"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "The upper construction that shelters a building from the weather, including its supporting and covering members where these are documented together."@en ;
      :hasAATReference <http://vocab.getty.edu/aat/300002098> .


###  https://wanqin-liu.github.io/ahkto/RoofingTile
:RoofingTile rdf:type owl:Class ;
             rdfs:subClassOf :DiscreteBuildingUnit ;
             rdfs:label "Roofing Tile"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "An individual tile made to form part of an overlapping or interlocking roof covering. Its record may describe a unit in place or one recovered from the roof."@en ;
             :hasAATReference <http://vocab.getty.edu/aat/300010699> .


###  https://wanqin-liu.github.io/ahkto/SculptureObject
:SculptureObject rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object> ;
                 rdfs:label "Sculpture Object"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable, independently produced three-dimensional sculptural objects created through human activity, including statues, figurative sculptures, and ornamental sculptures. Such objects may exist independently or be incorporated into architectural elements as decorative components."@en ;
                 :hasAATReference <http://vocab.getty.edu/aat/300047090> .


###  https://wanqin-liu.github.io/ahkto/Serliana
:Serliana rdf:type owl:Class ;
          rdfs:subClassOf :ArchitecturalAssemblies ;
          rdfs:label "Serliana"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A three-bay composition with an arched central opening and lower, flat-headed openings on either side. Record the complete composition at this level and its central arch as a component."@en ;
          :hasAATReference <http://vocab.getty.edu/aat/300311053> .


###  https://wanqin-liu.github.io/ahkto/Storey
:Storey rdf:type owl:Class ;
        rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E53_Place> ;
        rdfs:label "Storey"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> """This class comprises identifiable spatial regions corresponding to the vertical organization of a building into distinct levels. Instances of this class represent spatial subdivisions of a building generally associated with a particular elevation or range of elevations.

A storey may comprise one or more architectural spaces and may be associated with architectural elements located within or defining that level. Its spatial extent may be determined by the architectural configuration and vertical organization of the building.

Instances of this class represent spatial regions rather than physical construction elements, and therefore should be distinguished from floor slabs, floor finishes, and other architectural elements forming the physical boundaries of a storey."""@en ;
        :hasAATReference <http://vocab.getty.edu/aat/300002667> .


###  https://wanqin-liu.github.io/ahkto/Text
:Text rdf:type owl:Class ;
      rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
      rdfs:label "Text"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable information resources whose content is primarily expressed through written language. It includes historical records, archival documents, correspondence, scholarly publications, survey reports, conservation reports, descriptive accounts, and textual interpretations relating to architectural heritage. Textual resources may record actual conditions and historical events, present research findings, describe proposed interventions, or communicate hypothetical interpretations. The class concerns linguistic information content independently of its physical or digital carrier, publication status, file format, or documentary purpose. Textual content embedded in photographs, drawings, or other resources does not necessarily require the entire resource to be classified as Text."@en .


###  https://wanqin-liu.github.io/ahkto/TimberUnit
:TimberUnit rdf:type owl:Class ;
            rdfs:subClassOf :DiscreteBuildingUnit ;
            rdfs:label "Timber Unit"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "One piece of worked timber incorporated into a construction. Joint lines and the continuity of the timber distinguish it from adjacent pieces."@en .


###  https://wanqin-liu.github.io/ahkto/Vault
:Vault rdf:type owl:Class ;
       rdfs:subClassOf :ArchitecturalElement ;
       rdfs:label "Vault"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "A curved overhead construction spanning a space and transferring its loads to supporting walls or piers. Its geometry and its constituent units can be recorded at different levels."@en ;
       :hasAATReference <http://vocab.getty.edu/aat/300001324> .


###  https://wanqin-liu.github.io/ahkto/VaultType
:VaultType rdf:type owl:Class ;
           rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
           rdfs:label "Vault Type"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "A controlled concept used to classify vaults by their geometry or structural arrangement."@en .


###  https://wanqin-liu.github.io/ahkto/Video
:Video rdf:type owl:Class ;
       rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
       rdfs:label "Video"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "This class comprises identifiable information resources consisting of sequences of visual images intended to represent motion or changes over time, with or without accompanying sound. It includes audiovisual documentation, historical footage, survey recordings, animations, and digital presentations related to architectural heritage. Video resources may represent existing buildings, construction or conservation activities, historical transformations, proposed designs, or hypothetical reconstructions. The class is independent of the recording device, production technique, file format, and factual status of the represented content."@en .


###  https://wanqin-liu.github.io/ahkto/Voussoir
:Voussoir rdf:type owl:Class ;
          rdfs:subClassOf :DiscreteBuildingUnit ;
          rdfs:label "Voussoir"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "An individual wedge-shaped unit in the curved ring of an arch or vault. Its radial joints help identify it within the assembled fabric."@en ;
          :hasAATReference <http://vocab.getty.edu/aat/300001177> .


###  https://wanqin-liu.github.io/ahkto/Wall
:Wall rdf:type owl:Class ;
      rdfs:subClassOf :ArchitecturalElement ;
      rdfs:label "Wall"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "A substantially vertical construction that encloses or divides space. Its thickness may include several leaves, a core and finishes, each of which can be recorded separately."@en ;
      :hasAATReference <http://vocab.getty.edu/aat/300002469> .


